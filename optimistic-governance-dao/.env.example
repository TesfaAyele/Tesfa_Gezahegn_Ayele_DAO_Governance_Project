# Copy this file to `.env` and fill it in. NEVER commit the real `.env` (it is in .gitignore).

# --- Network access (needed for Sepolia deployment) ---
# RPC endpoint from Alchemy, Infura, QuickNode, etc.  e.g. https://eth-sepolia.g.alchemy.com/v2/<your-key>
SEPOLIA_RPC_URL=
# Private key (64 hex characters) of a THROWAWAY wallet funded with Sepolia test ETH.
# Never use a wallet that holds real funds.
PRIVATE_KEY=
# Optional: lets `deploy.js` verify the source code on Etherscan automatically
ETHERSCAN_API_KEY=

# --- DAO configuration (all optional; defaults shown) ---
# Comma-separated addresses. If left empty the deployer is used (fine for experiments only).
PROPOSERS=
GUARDIANS=
# How many guardians must veto (default: min(2, number of guardians))
GUARDIAN_THRESHOLD=
# Challenge window: 604800 = 7 days
DELAY_SECONDS=604800
# Time a passed proposal stays executable: 604800 = 7 days
GRACE_PERIOD_SECONDS=604800
# Share of total supply that can veto, in basis points: 1000 = 10%
CHALLENGE_THRESHOLD_BPS=1000
# Initial token supply, in whole tokens
INITIAL_SUPPLY=1000000
# Set to "true" to hand token minting rights to the governor
TRANSFER_TOKEN_OWNERSHIP=false
